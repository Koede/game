{
  "name": "hearthwatt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A voxel sandbox about heat, power and the furnace at the heart of your base.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch --serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "codex": "node scripts/codex/build.mjs",
    "e2e": "node scripts/e2e-all.mjs",
    "gen": "node scripts/gen-indexes.mjs",
    "ids:sync": "node scripts/ids-sync.mjs",
    "prebuild": "node scripts/gen-indexes.mjs",
    "pretypecheck": "node scripts/gen-indexes.mjs",
    "pretest": "node scripts/gen-indexes.mjs",
    "precodex": "node scripts/gen-indexes.mjs",
    "golden:update": "node scripts/golden-update.mjs",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "esbuild": "0.24.0",
    "playwright": "1.65.1",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  },
  "dependencies": {
    "three": "0.170.0"
  }
}
